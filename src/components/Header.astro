---
const navLinks = [
  { label: "Work", href: "/work" },
  { label: "About", href: "/about" },
  { label: "Kit", href: "/kit" },
  { label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="top-0 z-10 fixed bg-background/50 border border-secondary w-full"
>
  <div
    class="flex justify-between content-center mx-auto px-4 py-4 max-w-7xl h-14 font-display text-md uppercase tracking-wide"
  >
    <!-- LOGO -->
    <a
      href="/"
      aria-current={currentPath === "/" ? "page" : undefined}
      class="text-primary hover:text-accent">Maxime Duhamel</a
    >
    <!-- DESKTOP NAVIGATION -->
    <nav id="desktop-nav" class="hidden sm:block">
      <ul class="flex gap-4">
        {
          navLinks.map((link) => {
            const isPathActive = currentPath === link.href;

            return (
              <li class="group relative">
                <a
                  href={link.href}
                  aria-current={isPathActive ? "page" : undefined}
                  class:list={[
                    "group-hover:text-accent",
                    isPathActive ? "text-accent" : "text-primary",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
